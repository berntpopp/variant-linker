{
  "name": "variant-linker",
  "version": "3.12.2",
  "description": "CLI for Ensembl VEP and Variant Recoder",
  "main": "src/index.js",
  "bin": {
    "variant-linker": "./src/main.js"
  },
  "scripts": {
    "test": "mocha",
    "test:ci": "npm run test:coverage",
    "start": "node ./src/main.js",
    "build": "webpack --mode production",
    "serve": "webpack serve --mode development --open",
    "lint": "eslint . --max-warnings 0 --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
    "lint:fix": "eslint . --max-warnings 0 --fix --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
    "benchmark": "node scripts/benchmark.js",
    "docs:dev": "npm --prefix docs run start",
    "docs:build": "npm --prefix docs run build",
    "docs:serve": "npm --prefix docs run serve",
    "test:coverage": "c8 mocha",
    "test:live": "mocha --no-config --timeout 30000 test/live/*.test.cjs",
    "format:check": "prettier --check . --cache --cache-strategy content --cache-location node_modules/.cache/prettier/check",
    "format": "prettier --write . --cache --cache-strategy content --cache-location node_modules/.cache/prettier/write",
    "typecheck": "tsc --noEmit",
    "check:loc": "node scripts/check-loc.cjs",
    "verify": "node scripts/verify.cjs",
    "test:package": "node scripts/package-smoke.cjs",
    "test:focus": "mocha --no-config --require ./test/support/offline-setup.cjs --timeout 10000",
    "typecheck:watch": "tsc --noEmit --watch",
    "verify:static": "node scripts/verify.cjs --static"
  },
  "keywords": [
    "variant",
    "annotation",
    "Ensembl",
    "VEP",
    "CLI",
    "genetics"
  ],
  "author": "Bernt Popp",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/berntpopp/variant-linker.git"
  },
  "bugs": {
    "url": "https://github.com/berntpopp/variant-linker/issues"
  },
  "homepage": "https://berntpopp.github.io/variant-linker/",
  "files": [
    "src",
    "config",
    "schema",
    "scoring",
    "README.md",
    "LICENSE",
    "dist/variant-linker.bundle.js"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "dependencies": {
    "@gmod/vcf": "^6.0.9",
    "acorn": "^8.18.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "axios": "^1.20.0",
    "debug": "^4.3.4",
    "lru-cache": "^11.1.0",
    "node-interval-tree": "^2.1.2",
    "semver": "^7.7.1",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@babel/core": "^7.22.9",
    "@babel/preset-env": "^7.22.9",
    "@eslint/js": "^10.0.1",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/debug": "^4.1.13",
    "@types/node": "^22.20.2",
    "@types/semver": "^7.8.0",
    "@types/yargs": "^17.0.35",
    "babel-loader": "^9.1.2",
    "c8": "^12.0.0",
    "chai": "^4.3.4",
    "chai-as-promised": "^7.1.1",
    "chai-http": "^5.0.0",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.2",
    "globals": "^17.12.0",
    "json-loader": "^0.5.7",
    "mocha": "^12.0.0",
    "nock": "^14.0.17",
    "path-browserify": "^1.0.1",
    "prettier": "^3.5.3",
    "proxyquire": "^2.1.3",
    "semantic-release": "^25.0.9",
    "sinon": "^18.0.1",
    "sinon-chai": "^3.7.0",
    "table": "^6.9.0",
    "typescript": "~5.9.3",
    "webpack": "^5.110.3",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^5.2.6"
  },
  "browser": {
    "fs": false,
    "path": false,
    "os": false
  },
  "babel": {
    "presets": [
      "@babel/preset-env"
    ]
  },
  "overrides": {
    "qs": "^6.16.0",
    "sockjs": {
      "uuid": "^11.1.1"
    }
  }
}
